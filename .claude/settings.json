{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push origin master*)",
      "PowerShell(git push origin master*)",
      "Bash(git push * master*)",
      "PowerShell(git push * master*)",
      "Bash(git push *:master*)",
      "PowerShell(git push *:master*)",
      "Bash(git push origin main*)",
      "PowerShell(git push origin main*)",
      "Bash(git push * main*)",
      "PowerShell(git push * main*)",
      "Bash(git push *:main*)",
      "PowerShell(git push *:main*)",
      "Bash(git push origin staging*)",
      "PowerShell(git push origin staging*)",
      "Bash(git push * staging*)",
      "PowerShell(git push * staging*)",
      "Bash(git push *:staging*)",
      "PowerShell(git push *:staging*)",
      "Bash(git push --force*)",
      "PowerShell(git push --force*)",
      "Bash(git push * --force*)",
      "PowerShell(git push * --force*)",
      "Bash(git push -f*)",
      "PowerShell(git push -f*)",
      "Bash(git push * -f*)",
      "PowerShell(git push * -f*)",
      "Bash(git push * +*)",
      "PowerShell(git push * +*)",
      "Bash(git * --no-verify*)",
      "PowerShell(git * --no-verify*)",
      "Bash(git commit -n*)",
      "PowerShell(git commit -n*)",
      "Bash(git commit * -n*)",
      "PowerShell(git commit * -n*)",
      "Bash(git *core.hooksPath*)",
      "PowerShell(git *core.hooksPath*)",
      "Bash(gh *correcao-automatica*)",
      "PowerShell(gh *correcao-automatica*)",
      "Bash(gh api *labels*)",
      "PowerShell(gh api *labels*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/limpar-branches.sh",
            "timeout": 90
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-check.sh",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
